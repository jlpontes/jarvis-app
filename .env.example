# Copie para .env e ajuste. O .env nunca vai para o Git.
# Valores de exemplo: NÃO use estes em produção.

# development | production (em produção a API também serve o web compilado)
JARVIS_ENV=development
# Pasta dos dados (banco SQLite, backups). Padrão: ~/.jarvis-app
JARVIS_DATA_DIR=~/.jarvis-app
JARVIS_TZ=America/Sao_Paulo
# Banco do Jarvis C++, lido (só leitura) por `jarvis import-cpp-tasks`.
# JARVIS_CPP_DB_PATH=~/.jarvis/jarvis.db

# Login (navegador), token (outros clientes) e chave que assina o cookie de sessão.
# Em produção a API se recusa a subir com estes valores de exemplo ou com menos de 16 caracteres.
# Gere valores fortes com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_PASSWORD=troque-esta-senha
JARVIS_API_TOKEN=troque-este-token
JARVIS_SECRET_KEY=troque-esta-chave

# A partir do M5 (assistente).
# ANTHROPIC_API_KEY=
